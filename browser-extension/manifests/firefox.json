{
  "manifest_version": 2,
  "name": "Loki Browser Connector",
  "version": "0.1.0",
  "description": "Connects Loki agents to the user's real browser tabs.",
  "permissions": ["activeTab", "storage", "tabs", "<all_urls>"],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Loki Browser Connector"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "loki-browser-connector@loki.local"
    }
  }
}
