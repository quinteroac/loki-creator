# Copy this file to deploy/runpod/runpod.config.env or export these variables
# before running scripts/runpod/*. Provider credentials do not belong here.

GHCR_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/loki-creator
IMAGE_TAG=latest

RUNPOD_POD_NAME=loki-creator
RUNPOD_GPU_ID=NVIDIA GeForce RTX 4090
RUNPOD_GPU_COUNT=1
RUNPOD_CONTAINER_DISK_GB=80
RUNPOD_VOLUME_GB=200
RUNPOD_VOLUME_MOUNT_PATH=/workspace
RUNPOD_DATACENTER_ID=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_REGISTRY_AUTH_ID=
RUNPOD_PORTS=3000/http,22/tcp

# Optional comma-separated model capabilities to download on first boot.
# Examples: imagegen.generate,videogen.i2v,musicgen.generate
LOKI_MODEL_CAPABILITIES=
