#!/usr/bin/env bash

set -euo pipefail

source /usr/local/lib/loki-runpod/common.sh

strict=0
if [[ "${1:-}" == "--strict" ]]; then
  strict=1
fi

bootstrap_persistent_paths
load_runtime_secrets

failures=0

check_command() {
  local command_name="$1"
  if run_with_version "$command_name"; then
    printf '\n'
  else
    warn "missing required CLI: ${command_name}"
    failures=$((failures + 1))
  fi
}

check_bootstrap_command() {
  local command_name="$1"
  if command -v "$command_name" >/dev/null 2>&1; then
    printf '%s -> %s\n' "$command_name" "$(command -v "$command_name")"
    printf '%s: bootstrap-on-demand\n\n' "$command_name"
  else
    warn "missing required CLI wrapper: ${command_name}"
    failures=$((failures + 1))
  fi
}

check_comfy_imagegen_krea2() {
  local imagegen_bin="${LOKI_COMFY_TOOL_BIN_DIR}/comfy-imagegen"
  if [[ ! -x "$imagegen_bin" ]]; then
    printf 'comfy-imagegen krea2-generate: runtime not installed yet\n\n'
    return
  fi
  if "$imagegen_bin" --help 2>&1 | grep -q 'krea2-generate'; then
    printf 'comfy-imagegen krea2-generate: ok\n\n'
  else
    warn "installed comfy-imagegen is stale and does not expose krea2-generate"
    failures=$((failures + 1))
  fi
}

log "checking required CLIs"
for command_name in pi codex grok agy runpodctl; do
  check_command "$command_name"
done
for command_name in comfy-imagegen comfy-imagedescribe comfy-videogen comfy-musicgen comfy-models; do
  check_bootstrap_command "$command_name"
done
check_comfy_imagegen_krea2

log "checking frei0r video effects"
if ffmpeg -hide_banner -filters 2>/dev/null | grep -q ' frei0r '; then
  printf 'ffmpeg frei0r filter: ok\n'
else
  warn "ffmpeg is missing frei0r filter support"
  failures=$((failures + 1))
fi

frei0r_plugin_found=0
frei0r_paths=()
if [[ -n "${FREI0R_PATH:-}" ]]; then
  IFS=':' read -r -a frei0r_paths <<< "${FREI0R_PATH}"
fi
frei0r_paths+=("$HOME/.frei0r-1/lib" /usr/local/lib/frei0r-1 /usr/lib/frei0r-1)
for path in /usr/lib/*/frei0r-1; do
  [[ -d "$path" ]] && frei0r_paths+=("$path")
done
for path in "${frei0r_paths[@]}"; do
  if compgen -G "${path}/*.so" >/dev/null 2>&1; then
    printf 'frei0r plugins: %s\n' "$path"
    frei0r_plugin_found=1
    break
  fi
done
if [[ "$frei0r_plugin_found" -ne 1 ]]; then
  warn "no frei0r plugins found in FREI0R_PATH or standard library paths"
  failures=$((failures + 1))
fi

log "checking GPU visibility"
if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader 2>/dev/null || warn "nvidia-smi is installed but no GPU is visible"
else
  warn "nvidia-smi is not installed"
fi

log "checking sshd"
if pgrep -x sshd >/dev/null 2>&1; then
  printf 'sshd: ok\n'
else
  warn "sshd is not running"
  service_failures=1
fi

log "checking persistent auth/config stores"
for store in /workspace/.pi /workspace/.codex /workspace/.grok /workspace/.gemini /workspace/.loki /workspace/.loki/models/comfyui; do
  if [[ -d "$store" ]]; then
    printf 'present: %s\n' "$store"
  else
    warn "missing store: ${store}"
    failures=$((failures + 1))
  fi
done

log "checking local services"
service_failures="${service_failures:-0}"
if http_ok http://127.0.0.1:8001/api/health; then
  printf 'backend: ok\n'
else
  warn "backend health check failed at http://127.0.0.1:8001/api/health"
  service_failures=$((service_failures + 1))
fi

if http_ok http://127.0.0.1:8787/api/health; then
  printf 'agent bridge: ok\n'
else
  warn "agent bridge health check failed at http://127.0.0.1:8787/api/health"
  service_failures=$((service_failures + 1))
fi

if http_ok http://127.0.0.1:3000/; then
  printf 'frontend proxy: ok\n'
else
  warn "frontend proxy check failed at http://127.0.0.1:3000/"
  service_failures=$((service_failures + 1))
fi

if [[ "$strict" -eq 1 ]]; then
  failures=$((failures + service_failures))
fi

if [[ "$failures" -gt 0 ]]; then
  die "doctor found ${failures} required check failure(s)"
fi

log "doctor finished"
