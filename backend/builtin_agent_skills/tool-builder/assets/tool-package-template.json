{
  "manifestVersion": "1",
  "tool": {
    "id": "example-tool",
    "slug": "example-tool",
    "name": "Example Tool",
    "description": "Describe what the tool does and when to use it.",
    "version": "0.1.0",
    "author": "Loki",
    "origin": "user",
    "sourceType": "builtin",
    "invocationVisibility": "frontend",
    "capabilities": [],
    "inputSchema": {
      "type": "object",
      "required": ["prompt"],
      "properties": {
        "prompt": {
          "type": "string",
          "description": "Exact original user request. Preserve it as card prompt metadata."
        },
        "context": { "type": "object" },
        "selectedCards": { "type": "array", "items": { "type": "string" } },
        "params": {
          "type": "object",
          "properties": {
            "toolPrompt": {
              "type": "string",
              "description": "Operational tool instruction. Never render this directly as visible output."
            },
            "outputText": {
              "type": "string",
              "description": "Final user-visible text for card HTML."
            },
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "body": { "type": "string" },
            "footer": { "type": "string" }
          }
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": ["cards"],
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "prompt", "html"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "prompt": { "type": "string" },
              "html": { "type": "string" },
              "sourceToolId": { "type": "string" },
              "metadata": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["generic", "image", "video", "audio", "diagnostic", "artifact", "interactive"]
                  },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "thumbnailUrl": { "type": "string" },
                  "artifactUrl": { "type": "string" },
                  "preferredAspectRatio": { "type": "string", "enum": ["1:1", "4:3", "16:9", "auto"] },
                  "playableMedia": { "type": "boolean" },
                  "tags": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "exportable": true,
    "runtime": {
      "sourceType": "builtin",
      "entrypoint": "example-tool",
      "command": [],
      "method": "POST",
      "timeoutSeconds": 120
    },
    "permissions": {
      "network": false,
      "filesystem": false,
      "envVars": [],
      "allowedCommands": []
    },
    "configuration": []
  },
  "assets": [],
  "secretsRequired": [],
  "integrity": {}
}
