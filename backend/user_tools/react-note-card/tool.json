{
  "manifestVersion": "1",
  "tool": {
    "id": "react-note-card",
    "slug": "react-note-card",
    "name": "React Note Card",
    "description": "Creates a user-owned Loki canvas note card using React server rendering.",
    "version": "0.1.0",
    "author": "Loki User",
    "origin": "user",
    "sourceType": "cli-local",
    "invocationVisibility": "frontend",
    "capabilities": ["react", "node", "html-card-output"],
    "inputSchema": {
      "type": "object",
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string" },
        "context": { "type": "object" },
        "selectedCards": { "type": "array", "items": { "type": "string" } },
        "params": { "type": "object" }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": ["cards"],
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "prompt", "html"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "prompt": { "type": "string" },
              "html": { "type": "string" },
              "sourceToolId": { "type": "string" }
            }
          }
        }
      }
    },
    "exportable": true,
    "runtime": {
      "sourceType": "cli-local",
      "entrypoint": "src/index.tsx",
      "command": ["bun", "run", "src/index.tsx"],
      "method": "POST",
      "timeoutSeconds": 30
    },
    "permissions": {
      "network": false,
      "filesystem": true,
      "envVars": [],
      "allowedCommands": ["bun"]
    },
    "configuration": []
  },
  "assets": [],
  "secretsRequired": [],
  "integrity": {}
}
