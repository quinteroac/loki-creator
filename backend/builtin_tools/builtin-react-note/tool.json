{
  "manifestVersion": "1",
  "tool": {
    "id": "builtin-react-note",
    "slug": "builtin-react-note",
    "name": "Built-in React Note",
    "description": "Creates a Loki canvas note card using a built-in React server-rendered tool.",
    "version": "0.1.0",
    "author": "Loki",
    "origin": "built-in",
    "sourceType": "cli-local",
    "invocationVisibility": "frontend",
    "capabilities": [
      "react",
      "node",
      "html-card-output"
    ],
    "inputSchema": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "context": {
          "type": "object"
        },
        "selectedCards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "properties": {
            "html": {
              "type": "string",
              "description": "Complete self-contained HTML authored by the model. For selected-card edits, this should be the transformed selected card artifact."
            },
            "cardHtml": {
              "type": "string"
            },
            "outputHtml": {
              "type": "string"
            }
          }
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "cards"
      ],
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "prompt",
              "html"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "html": {
                "type": "string"
              },
              "sourceToolId": {
                "type": "string"
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "generic",
                      "image",
                      "video",
                      "audio",
                      "diagnostic",
                      "artifact",
                      "interactive"
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "thumbnailUrl": {
                    "type": "string"
                  },
                  "artifactUrl": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "preferredAspectRatio": {
                    "type": "string",
                    "enum": [
                      "1:1",
                      "4:3",
                      "16:9",
                      "auto"
                    ]
                  },
                  "playableMedia": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "exportable": false,
    "runtime": {
      "sourceType": "cli-local",
      "entrypoint": "src/index.tsx",
      "command": [
        "bun",
        "run",
        "src/index.tsx"
      ],
      "method": "POST",
      "timeoutSeconds": 30
    },
    "permissions": {
      "network": false,
      "filesystem": true,
      "envVars": [],
      "allowedCommands": [
        "bun"
      ]
    },
    "configuration": []
  },
  "assets": [],
  "secretsRequired": [],
  "integrity": {}
}
